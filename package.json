{
  "name": "skportfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Sukhraj Kalon's statically exported Orbital Engineering Journey portfolio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukhraj1000/SKPortfolio.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/next-safe-webstorage.mjs dev --turbopack",
    "build": "node scripts/next-safe-webstorage.mjs build",
    "export": "npm run build",
    "start": "node scripts/serve-static-export.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "qa": "npm run qa:source && npm run build && npm run qa:static && npm run qa:server && npm run qa:audit && npm run qa:ui",
    "qa:source": "npm run format:check && npm run lint && npm run typecheck && npm run qa:unused && npm run qa:references && npm run qa:workflows",
    "qa:unused": "knip --no-progress",
    "qa:references": "node scripts/validate-references.mjs",
    "qa:workflows": "node scripts/validate-workflows.mjs",
    "qa:static": "node scripts/validate-static-export.mjs",
    "qa:server": "node scripts/validate-static-server.mjs",
    "qa:audit": "npm audit --audit-level=high",
    "qa:ui": "npm run qa:ui:chromium && npm run qa:ui:compat",
    "qa:ui:chromium": "playwright test --project=chromium",
    "qa:ui:compat": "playwright test --project=firefox-compat --project=webkit-compat",
    "qa:ui:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.3.1",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
