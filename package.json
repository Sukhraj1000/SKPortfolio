{
  "name": "skportfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Sukhraj Kalon's statically exported Pixel Quest software engineering portfolio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukhraj1000/SKPortfolio.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/next-safe-webstorage.mjs dev --turbopack",
    "build": "node scripts/next-safe-webstorage.mjs build",
    "export": "node scripts/next-safe-webstorage.mjs build",
    "qa": "npm run lint && npm run typecheck && npm run build && npm run qa:static",
    "qa:static": "node scripts/validate-static-export.mjs",
    "qa:ui": "playwright test",
    "qa:ui:install": "playwright install chromium",
    "start": "node scripts/next-safe-webstorage.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
