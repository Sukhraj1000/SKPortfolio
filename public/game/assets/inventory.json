      "grid": { "columns": 4, "rows": 4 },
      "frame": { "width": 48, "height": 64 },
      "intendedUse": "SK player-character animation before physics or collision bounds are applied",
      "animations": {
        "idle": {
          "frames": [0, 1],
          "fps": 2,
          "loop": true,
          "intendedUse": "Default grounded state"
        },
        "runRight": {
          "frames": [2, 3],
          "fps": 8,
          "loop": true,
          "intendedUse": "Horizontal movement facing right"
        },
        "runLeft": {
          "frames": [4, 5],
          "fps": 8,
          "loop": true,
          "intendedUse": "Horizontal movement facing left"
        },
        "jump": {
          "frames": [6],
          "fps": 1,
          "loop": false,
          "intendedUse": "Ascending airborne state"
        },
        "fall": {
          "frames": [7],
          "fps": 1,
          "loop": false,
          "intendedUse": "Descending airborne state"
        },
        "land": {
          "frames": [8],
          "fps": 1,
          "loop": false,
          "intendedUse": "Brief grounded landing state"
        },
        "interact": {
          "frames": [9, 10],
          "fps": 3,
          "loop": true,
          "intendedUse": "Story pickup or checkpoint interaction"
        },
        "glitch": {
          "frames": [11],
          "fps": 1,
          "loop": false,
          "intendedUse": "Brief damage or system-corruption feedback"
        },
        "dropIn": {
          "frames": [12, 13, 14, 15],
          "fps": 6,
          "loop": false,
          "intendedUse": "Header-hatch spawn sequence"
        }
      }
    },
